# RootCellar color scheme — derived from BreezeDark (LGPL-2.0-or-later,
# KDE VDG) with the cellar palette: terminal bg #191622 family, Raddix
# purple #A06BE0 accent, rose/sea/sand state colors matching the foot
# terminal and the gtk4.css overlay. Structure is a straight copy of
# BreezeDark so every Plasma widget group stays schema-correct.
# SPDX-License-Identifier: LGPL-2.0-or-later

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
