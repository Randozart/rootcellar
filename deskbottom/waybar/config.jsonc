// RootCellar waybar configuration — the cellar's top panel.
// Deployed to /etc/cellar/waybar/config.jsonc; see PLAN-HYPRDESK.md.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["custom/menu", "sway/workspaces", "sway/mode"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": ["custom/win-minimize", "custom/win-maximize", "custom/win-close", "custom/win-extend", "custom/help", "clock"],

    // Start menu: click, or Ctrl+Alt+Space.
    "custom/menu": {
        "format": " ≡ ",
        "on-click": "/etc/cellar/cellar menu",
        "tooltip": false
    },

    "sway/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        // Always show 1-5 so empty workspaces are visible and clickable
        // (sway creates a workspace on demand when you switch to it).
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "sway/mode": {
        "format": "{}"
    },

    // Every running window: app icon + title. Click to focus,
    // middle-click to close.
    "wlr/taskbar": {
        "format": "{icon} {title}",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "active-first": true,
        "icon-size": 16
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/help": {
        "format": " Help",
        "on-click": "/etc/cellar/cellar-help | fuzzel --dmenu --prompt 'Keybindings' --width 60 --lines 14",
        "tooltip": false
    },

    // Window controls for the native WSLg window (see cellar windowctl).
    "custom/win-minimize": {
        "format": "\u2500",
        "on-click": "/etc/cellar/cellar minimize",
        "tooltip": false
    },

    "custom/win-maximize": {
        "format": "\u25A1",
        "on-click": "/etc/cellar/cellar maximize",
        "tooltip": false
    },

    "custom/win-close": {
        "format": "\u00D7",
        "on-click": "/etc/cellar/cellar close",
        "tooltip": false
    },

    // Move the desktop to another monitor (picker); the window has no
    // title bar, so it cannot be dragged.
    "custom/win-extend": {
        "format": "\u21F1",
        "on-click": "/etc/cellar/cellar extend",
        "tooltip": false
    }
}
