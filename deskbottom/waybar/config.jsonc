// RootCellar waybar configuration — the cellar's top panel.
// Deployed to /etc/cellar/waybar/config.jsonc; see PLAN-HYPRDESK.md.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["custom/help", "clock"],

    "sway/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "sway/mode": {
        "format": "{}"
    },

    "sway/window": {
        "format": "{}",
        "max-length": 50
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/help": {
        "format": " Help",
        "on-click": "/etc/cellar/cellar-help | wofi --dmenu --prompt 'Keybindings' --width 400 --height 300",
        "tooltip": false
    }
}
