// RootCellar bottom bar — the hotkey hint line. Each entry is
// "key: action" with the Ctrl+Alt mod implied. Grouped by function.
// Deployed to /etc/cellar/waybar/config-bottom.jsonc; a second waybar
// instance (see labwc autostart). The old sway/mode tag is gone: labwc
// has no modes.
{
    "layer": "top",
    "position": "bottom",
    "height": 22,
    "spacing": 6,

    "modules-left": ["custom/hints"],
    "modules-center": [],
    "modules-right": [],

    "custom/hints": {
        "format": " Ctrl+Alt  h/l prev/next win · ←↓↑→ move · ⇧←↓↑→ resize · 1-5 ws · Space menu · t term · x close · f full · w max · [ ] monitor · F1 help ",
        "tooltip": false
    }
}