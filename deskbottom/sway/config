# sway — the cellar's window manager (headless, streamed via noVNC).
# Deployed to /etc/cellar/sway/config; see PLAN-HYPRDESK.md.
# Escape hatch: SUPER+SHIFT+E exits the compositor (with confirmation);
# the Windows side is always reachable via Alt+F4 on the kiosk overlay.

# ── Output ──────────────────────────────────────────────────────────
# wlroots' headless backend auto-creates HEADLESS-1; pin mode + scale to
# the physical panel (1920x1200 at 125% Windows scaling): the framebuffer
# then matches the panel 1:1 and the UI stays logically sized. The overlay
# kiosk connects with a plain scale URL — resize=remote would drag the
# framebuffer back down to CSS pixels and re-soften everything.
output HEADLESS-1 mode --custom 1920x1200@60Hz
output HEADLESS-1 scale 1.25
output HEADLESS-1 bg /etc/cellar/sway/bg.jpg fill

# ── Startup ─────────────────────────────────────────────────────────
exec waybar -c /etc/cellar/waybar/config.jsonc -s /etc/cellar/waybar/style.css
exec swaybg -o HEADLESS-1 -i /etc/cellar/sway/bg.jpg -m fill
exec foot

# ── Appearance ──────────────────────────────────────────────────────
# Gaps: 8px inner so the wallpaper peeks between windows. Top gap
# reserved for waybar (32px bar + 4px padding = 36px).
gaps inner 8
gaps top 36
default_border pixel 2
default_floating_border pixel 2
font pango:DejaVu Sans 10
xwayland enable
seat * hide_cursor 2000

# ── Keybinds ────────────────────────────────────────────────────────
set $mod Mod4
set $term foot

# Windows
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec foot --app-id=cellar-dock -e zellij attach cellar --create
bindsym $mod+b exec firefox
bindsym $mod+d exec wofi --show drun
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+e layout toggle split
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway and the desktop session?' -B 'Exit' 'swaymsg exit'
bindsym $mod+Shift+question exec /etc/cellar/cellar-help | wofi --dmenu --prompt "Keybindings" --width 400 --height 300

# Focus movement
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
