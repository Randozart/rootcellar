# sway — the cellar's window manager (nested inside WSLg's Weston).
# Deployed to /etc/cellar/sway/config; see PLAN-KEYBINDS.md and
# docs/CONVENIENT-DESKTOP.md.
#
# The desk modifier is Ctrl+Alt (Control+Mod1), spelled out in every bind —
# there is no $mod variable. It cannot be Super: WSLg sends the Windows key
# to Windows, not the guest (wslg#672), and a sway-side xkb remap cannot
# manufacture a modifier because the nested modifier mask comes from Weston
# (wlroots forwards key events with update_state=false). See PLAN-KEYBINDS.md.
#
# Escape hatch: Ctrl+Alt+Q exits the compositor (with confirmation); the
# Windows side is always reachable via Alt+F4.

# ── Output ──────────────────────────────────────────────────────────
# In WSLg nesting, sway is a Wayland client of Weston: the output
# name is assigned by the host compositor (typically WL-1), not a
# headless output we control. Pin scale 1.0 and let the host drive
# resolution — it matches the Windows window size.
output * scale 1.0
output * bg /etc/cellar/sway/bg.jpg fill

# ── Startup ─────────────────────────────────────────────────────────
exec waybar -c /etc/cellar/waybar/config.jsonc -s /etc/cellar/waybar/style.css
exec swaybg -i /etc/cellar/sway/bg.jpg -m fill
exec mako
# Clipboard history: watch the Wayland clipboard and store every entry
# (recalled with Ctrl+Alt+V).
exec wl-paste --watch cliphist store
# Auto-split along the longer edge — makes tiling feel natural.
exec autotiling
# Zellij-style hotkey hint line at the bottom edge.
exec waybar -c /etc/cellar/waybar/config-bottom.jsonc -s /etc/cellar/waybar/style-bottom.css

# ── Appearance ──────────────────────────────────────────────────────
# Gaps: 8px inner so the wallpaper peeks between windows. Top gap
# reserved for waybar (32px bar + 4px padding = 36px).
gaps inner 8
gaps top 36
default_border pixel 2
default_floating_border pixel 2
smart_borders on
font pango:Inter 10
seat * hide_cursor 2000
seat * xcursor_theme Bibata-Modern-Ice 24

# Catppuccin-mocha accent borders — mauve on focus, muted surface elsewhere.
# Format: client.<class> <border> <bg> <text> [<indicator> [<child_border>]]
client.focused          #cba6f7 #cba6f7 #1e1e2e #cba6f7 #cba6f7
client.focused_inactive #585b70 #585b70 #cdd6f4 #585b70 #585b70
client.unfocused        #313244 #313244 #6c7086 #313244 #313244
client.urgent           #f38ba8 #f38ba8 #1e1e2e #f38ba8 #f38ba8

# ── Keybinds ────────────────────────────────────────────────────────
# One prefix, one key: every desk action is Ctrl+Alt+<key>. The letters
# match Zellij's (see deskbottom/zellij/config.kdl) so there is one
# vocabulary across both layers.
set $term foot

# Startup: dock straight into the desktop's own Zellij session. It is
# deliberately NOT the terminal deskbottom's `cellar` session: Zellij
# sizes a shared session to its smallest client, so sharing with the
# Windows-side WezTerm clamped the desktop. A separate session renders
# at its own size.
exec foot -e zellij attach cellar-desk --create

# ── Launching ───────────────────────────────────────────────────────
bindsym Ctrl+Alt+space exec /etc/cellar/cellar menu
bindsym Ctrl+Alt+t exec $term
bindsym Ctrl+Alt+d exec fuzzel
bindsym Ctrl+Alt+b exec firefox
bindsym Ctrl+Alt+o exec nautilus
bindsym Ctrl+Alt+s exec /etc/cellar/cellar store
bindsym Ctrl+Alt+v exec /etc/cellar/cellar clipboard
bindsym Ctrl+Alt+p exec /etc/cellar/cellar screenshot
bindsym Ctrl+Alt+F1 exec /etc/cellar/cellar-help | fuzzel --dmenu --prompt "Keybindings" --width 60 --lines 14

# ── Windows ─────────────────────────────────────────────────────────
bindsym Ctrl+Alt+x kill
bindsym Ctrl+Alt+f fullscreen toggle
bindsym Ctrl+Alt+w floating toggle
# Layout cycle: split ↔ tabbed ↔ stacking.
bindsym Ctrl+Alt+e layout toggle splith splitv tabbed stacking
bindsym Ctrl+Alt+q exec swaynag -t warning -m 'Exit sway and the desktop session?' -B 'Exit' 'swaymsg exit'

# ── Focus movement ──────────────────────────────────────────────────
bindsym Ctrl+Alt+h focus left
bindsym Ctrl+Alt+l focus right
bindsym Ctrl+Alt+k focus up
bindsym Ctrl+Alt+j focus down

# ── Move windows ────────────────────────────────────────────────────
bindsym Ctrl+Alt+Left move left
bindsym Ctrl+Alt+Right move right
bindsym Ctrl+Alt+Up move up
bindsym Ctrl+Alt+Down move down

# ── Resize mode (Ctrl+Alt+R, then arrows or H/J/K/L, Esc to exit) ────
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym j resize grow height 10 px
    bindsym k resize shrink height 10 px
    bindsym l resize grow width 10 px
    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym Ctrl+Alt+r mode "resize"

# ── Mouse window control ────────────────────────────────────────────
# Ctrl+Alt+drag: left moves (a tiled window floats and follows the
# cursor), right resizes. Dragging any window's border also resizes.
bindsym --whole-window Ctrl+Mod1+button1 move
bindsym --whole-window Ctrl+Mod1+button3 resize
bindsym --border button1 resize

# ── Workspaces ──────────────────────────────────────────────────────
# Switch directly; move the focused window with the Ctrl+Alt+M picker
# (which also creates a workspace on demand).
bindsym Ctrl+Alt+1 workspace number 1
bindsym Ctrl+Alt+2 workspace number 2
bindsym Ctrl+Alt+3 workspace number 3
bindsym Ctrl+Alt+4 workspace number 4
bindsym Ctrl+Alt+5 workspace number 5
bindsym Ctrl+Alt+m exec /etc/cellar/cellar move-to-workspace
