#!/usr/bin/env bash
# cellar-help — show the keybinding reference in wofi.
# Called by Ctrl+Alt+Shift+? or the waybar Help button.
set -euo pipefail

cat <<'KEYS'
  Modifier: Ctrl + Alt   (the Windows key never reached sway)

  Launching
  Ctrl + Alt + Space        Start menu
  Ctrl + Alt + D            App launcher
  Ctrl + Alt + Shift + D    Software center
  Ctrl + Alt + Return       New terminal
  Ctrl + Alt + B            Firefox
  Ctrl + Alt + Shift + V    Clipboard history
  Print                     Screenshot a region

  Windows
  Ctrl + Alt + Q            Kill window
  Ctrl + Alt + F            Fullscreen toggle
  Ctrl + Alt + Shift + Space  Floating toggle
  Ctrl + Alt + E            Layout: split / tabbed / stacking
  Ctrl + Alt + Shift + E    Exit sway
  Ctrl + Alt + Shift + ?    This help

  Focus / move
  Ctrl + Alt + H / J / K / L       Focus left / down / up / right
  Ctrl + Alt + Shift + H / J / K / L  Move window
  Ctrl + Alt + R            Resize mode (arrows, then Esc)
  Ctrl + Alt + left-drag    Move a window (mouse)
  Ctrl + Alt + right-drag   Resize a window (mouse)

  Workspaces
  Ctrl + Alt + 1 – 5        Switch workspace
  Ctrl + Alt + Shift + 1 – 5   Move window to workspace

  Zellij (inside the desktop session)
  Alt + N                   New pane
  Alt + arrows              Focus

  Windows side
  Alt + F4                  Close the window

  Title bar buttons (top-right): ─ minimize, □ maximize/restore, × close,
    ⇱ move to another monitor (picker)
    × fully closes the desktop — relaunch with `cellar ui`
KEYS