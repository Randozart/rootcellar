#!/usr/bin/env bash
# cellar-help — show the keybinding reference in wofi.
# Called by Ctrl+Alt+Shift+? or waybar Help button.
set -euo pipefail

cat <<'KEYS'
  $mod = Ctrl + Alt  (Windows owns the Windows key; we stopped fighting)

  $mod + Return          New terminal
  (shared Zellij session docks automatically at startup)
  $mod + B               Firefox
  $mod + D               App launcher
  $mod + Q               Kill window
  $mod + F               Fullscreen toggle (within sway)
  $mod + T               Toggle split
  $mod + H / J / K / L   Focus left / down / up / right
  $mod + 1 – 5           Switch workspace
  $mod + Shift + 1 – 5   Move window to workspace
  $mod + Shift + K       Exit kiosk (no-op, kept for compat)
  $mod + Shift + ?       This help
  $mod + Shift + E       Exit sway
  Alt + N                New pane (in Zellij)
  Alt + arrows           Focus (in Zellij)
  Alt + F4               Close sway window (Windows side)

  Desktop is a native WSLg window — no browser overlay needed.
  `cellar overlay` or `cellar fullscreen` maximizes it.
KEYS
