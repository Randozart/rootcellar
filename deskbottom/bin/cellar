#!/usr/bin/env bash
# cellar — start menu and session control for the RootCellar deskbottom.
#
# Usage:
#   cellar [deskbottom]  attach to (or boot) the deskbottom
#   cellar app [key]     start menu: fuzzy-pick an app from apps.toml
#   cellar list          list registered apps and whether they are installed
#   cellar kill          tear down the cellar session (asks first)
#   cellar deploy        sync repo -> /opt and rebuild (--no-rebuild to skip)
#   cellar update        pull from origin, show changes, then deploy
#   cellar overlay       toggle maximize on the native WSLg sway window
#   cellar maximize      toggle maximize/restore (same as overlay)
#   cellar minimize      minimize the sway window to the Windows taskbar
#   cellar extend [n]    move the desktop to another monitor and fill it
#   cellar shrink        un-maximize the desktop back to a window
#   cellar close         fully close the desktop (stops sway-headless)
#   cellar ui            relaunch the desktop UI after a close
#   cellar menu          start menu (applications, files, software, settings)
#   cellar center        visual software center (local / freeze-in packages)
#   cellar store         quick fuzzel software picker (search nixpkgs)
#   cellar use <pkg>     install locally now (nix profile, no rebuild)
#   cellar unuse <pkg>   remove a locally installed package
#   cellar freeze <pkg>  promote a package into the declarative list
#   cellar unfreeze <pkg> drop a package from the declarative list
#   cellar profile       list local packages (--json for the GUI)
#   cellar frozen        list frozen packages (--json for the GUI)
#   cellar clipboard     clipboard history picker
#   cellar move-to-workspace  move the focused window to a workspace (fuzzel)
#   cellar screenshot    region screenshot to the clipboard
#   cellar config        cozy menu: settings + features (then deploy)
#   cellar pkgs          package manager: search, install, remove
#   cellar add <pkg>     install a nixpkgs package (also: remove, search,
#                        check)
#   cellar link [url]    show/set the config repo this cellar follows
#   cellar save          commit + push pending config changes
#   cellar refresh       clear sessions and boot the desk fresh
#   cellar netcheck      diagnose networking and localhost forwarding
#   cellar docker-doctor check Docker Desktop compatibility
#   cellar interop        check WSL .exe interop (windowctl depends on it)

set -Eeuo pipefail

SESSION="${CELLAR_SESSION:-cellar}"
APPS_FILE="${CELLAR_APPS:-/etc/cellar/apps.toml}"
# The dev clone on the Windows side is the source of truth. The default
# assumes the Windows username matches the cellar user; override with
# CELLAR_REPO when it does not. SUDO_USER keeps the path right when the
# script is re-invoked as root (`sudo cellar deploy-root`).
CELLAR_USER="${SUDO_USER:-$(whoami)}"
REPO="${CELLAR_REPO:-/mnt/c/Users/${CELLAR_USER}/Documents/Projects/rootcellar}"
TARGET="/opt/rootcellar"
PACKAGES_LIST="$REPO/modules/user-packages.list"
CELLAR_TOML="$REPO/cellar.toml"
# Absolute path to this script, for the privileged re-invocation.
CELLAR_SELF="${CELLAR_SELF:-$(command -v cellar 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")}"

usage() {
	# Print the leading comment block (line 2 onward) without the '#'.
	awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' \
		"${BASH_SOURCE[0]}"
}
toml_value() {
	# Right side of the first '=', whitespace-trimmed, then quote-trimmed.
	local v="${1#*=}"
	v="${v#"${v%%[![:space:]]*}"}"
	v="${v%"${v##*[![:space:]]}"}"
	v="${v#\"}"
	v="${v%\"}"
	printf '%s' "$v"
}

parse_apps() {
	# Emits TSV: key <TAB> name <TAB> command
	local key="" name="" cmd=""
	local line
	while IFS= read -r line || [[ -n "$line" ]]; do
		case "$line" in
			"["*"]")
				if [[ -n "$key" && -n "$cmd" ]]; then
					printf '%s\t%s\t%s\n' "$key" "$name" "$cmd"
				fi
				key="${line#\[}"
				key="${key%\]}"
				name=""
				cmd=""
				;;
			name\ =\ * | name=*)
				name="$(toml_value "$line")"
				;;
			command\ =\ * | command=*)
				cmd="$(toml_value "$line")"
				;;
		esac
	done <"$APPS_FILE"
	if [[ -n "$key" && -n "$cmd" ]]; then
		printf '%s\t%s\t%s\n' "$key" "$name" "$cmd"
	fi
}

in_zellij() { [[ -n "${ZELLIJ:-}" ]]; }

launch() {
	local cmd="$1"
	if in_zellij; then
		zellij action new-pane --close-on-exit -- bash -lc "$cmd"
	else
		exec bash -lc "$cmd"
	fi
}

cmd_desktop() {
	if command -v zellij >/dev/null 2>&1; then
		exec zellij attach "$SESSION" --create
	else
		echo "zellij is not installed; the deskbottom cannot boot." >&2
		exit 69
	fi
}

cmd_app() {
	local key="${1:-}"
	if [[ -z "$key" ]]; then
		local selection
		selection="$(
			parse_apps | awk -F'\t' '{ printf "%s  %-28s [%s]\n", $1, $2, $3 }' |
				fzf --height=40% --reverse --prompt="cellar> "
		)" || return 0
		key="${selection%%[[:space:]]*}"
	fi

	local row
	row="$(parse_apps | awk -F'\t' -v k="$key" '$1 == k { print; exit }')"
	if [[ -z "$row" ]]; then
		echo "No app registered under key '$key'. Try: cellar list" >&2
		exit 66
	fi

	local cmd
	cmd="$(printf '%s' "$row" | awk -F'\t' '{ print $3 }')"
	launch "$cmd"
}

cmd_list() {
	while IFS=$'\t' read -r key name cmd; do
		if command -v "${cmd%% *}" >/dev/null 2>&1; then
			printf 'ok   %s  %s\n' "$key" "$name"
		else
			printf 'MISS %s  %s  (%s not found)\n' "$key" "$name" "${cmd%% *}"
		fi
	done < <(parse_apps)
}

cmd_kill() {
	read -r -p "Kill Zellij session '$SESSION'? All running panes will die. [y/N] " reply
	if [[ "$reply" == "y" || "$reply" == "Y" ]]; then
		zellij kill-session "$SESSION"
	else
		echo "Aborted."
	fi
}

cmd_deploy() {
	local rebuild=1
	if [[ "${1:-}" == "--no-rebuild" ]]; then
		rebuild=0
	elif [[ -n "${1:-}" ]]; then
		echo "Unknown flag: $1 (supported: --no-rebuild)" >&2
		exit 64
	fi
	if [[ ! -d "$REPO" ]]; then
		echo "Repo not found: $REPO" >&2
		exit 66
	fi

	# The root half runs through one `sudo` (so the GUI can feed a single
	# password); the user half must run as the invoking user.
	if [[ "$rebuild" -eq 1 ]]; then
		sudo "$CELLAR_SELF" deploy-root
		cmd_deploy_user
	else
		sudo "$CELLAR_SELF" deploy-sync
	fi
}

# The privileged half of a deploy: mirror the repo into /opt and switch
# the system. Runs as root (via `sudo cellar deploy-root`), so it never
# calls sudo itself.
cmd_deploy_root() {
	deploy_require_root deploy-root
	deploy_sync_root
	/run/current-system/sw/bin/nixos-rebuild switch --flake "$TARGET#rootcellar"
	echo "cellar deploy: synced and switched"
}

# Sync-only, for `cellar deploy --no-rebuild`.
cmd_deploy_sync() {
	deploy_require_root deploy-sync
	deploy_sync_root
	echo "cellar deploy: synced (no rebuild)"
}

# The unprivileged half: a switch only *reloads* user units, so new units
# never start and removed ones keep running. Reload and bounce the desktop
# units so /etc matches reality; try-restart no-ops on units that are down
# or gone. Must run as the user, never as root.
cmd_deploy_user() {
	systemctl --user daemon-reload
	local u
	for u in labwc-headless xfce-session hyprland-headless; do
		systemctl --user stop "$u" 2>/dev/null || true
	done
	pkill -x labwc 2>/dev/null || true
	pkill -x Hyprland 2>/dev/null || true
	pkill -x xfce4-session 2>/dev/null || true
	systemctl --user try-restart sway-headless 2>/dev/null || true
}

deploy_require_root() {
	[[ "$(id -u)" -eq 0 ]] || {
		echo "This must run as root (use: sudo cellar ${1:-deploy-root})" >&2
		exit 77
	}
	[[ -d "$REPO" ]] || {
		echo "Repo not found: $REPO" >&2
		exit 66
	}
}

# The repo is the source of truth; /opt is a derived mirror. The mirror's
# flake must keep local path inputs (the cellar cannot fetch from github),
# so the sync re-derives them after every copy. Assumes root.
deploy_sync_root() {
	bash -c '
		set -Eeuo pipefail
		tar -C "$1" --exclude=.git -cf - . | tar -xf - -C "$2"
		sed -i \
			-e "s|github:NixOS/nixpkgs/nixos-25.05|path:/opt/nixpkgs-ac62194c3917d5f474c1a844b6fd6da2db95077d|" \
			-e "s|github:NixOS/nixpkgs/nixos-unstable|path:/opt/nixpkgs-nixos-unstable|" \
			-e "s|github:nix-community/NixOS-WSL|path:/opt/NixOS-WSL-eaeb18da90024448a60eb1ec7132eafa4003404e|" \
			"$2/flake.nix"
	' deploy "$REPO" "$TARGET"
}

cmd_refresh() {
	local running
	running="$(zellij list-sessions -s 2>/dev/null | grep -vc EXITED || true)"
	if [[ "$running" -gt 0 ]]; then
		read -r -p "Kill $running running session(s) and boot the desk fresh? [y/N] " reply
		if [[ "$reply" != "y" && "$reply" != "Y" ]]; then
			echo "Aborted."
			return 0
		fi
	fi
	if in_zellij; then
		# Killing the session we are inside of would cut this command off
		# mid-flight, so spare $ZELLIJ and hand control back: an explicit
		# Ctrl+q quits without leaving resurrection state, and the next
		# login boots fresh.
		while IFS= read -r s; do
			[[ -n "$s" && "$s" != "$ZELLIJ" ]] && zellij kill-session "$s" 2>/dev/null || true
		done < <(zellij list-sessions -s 2>/dev/null | grep -v EXITED)
		zellij delete-all-sessions --yes 2>/dev/null || true
		echo "Refreshed (other sessions cleared). Exit Zellij with Ctrl+q;"
		echo "the deskbottom comes back fresh on autostart."
	else
		zellij kill-all-sessions --yes 2>/dev/null || true
		zellij delete-all-sessions --yes 2>/dev/null || true
		exec zellij attach "$SESSION" --create
	fi
}

cmd_update() {
	local do_inputs=0 dry_run=0 check_kernel=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--inputs) do_inputs=1 ;;
			--dry-run) dry_run=1 ;;
			--kernel) check_kernel=1 ;;
			*)
				echo "Unknown flag: $1 (supported: --inputs, --dry-run, --kernel)" >&2
				exit 64
				;;
		esac
		shift
	done

	if [[ ! -d "$REPO/.git" ]]; then
		echo "Not a git repo: $REPO" >&2
		exit 66
	fi

	# Phase 1: Pull
	echo "==> Pulling latest from origin..."
	if ! git -C "$REPO" pull --ff-only; then
		echo "Pull failed (branch diverged). Resolve manually." >&2
		exit 1
	fi

	# Show what changed
	local diff_output
	diff_output="$(git -C "$REPO" log "HEAD@{1}..HEAD" --oneline 2>/dev/null || true)"
	if [[ -n "$diff_output" ]]; then
		echo ""
		echo "Updates pulled:"
		echo "$diff_output"
	else
		echo "Already up to date."
		[[ "$dry_run" -eq 1 ]] && return 0
	fi

	[[ "$dry_run" -eq 1 ]] && return 0

	# Phase 2 (optional): Flake update
	if [[ "$do_inputs" -eq 1 ]]; then
		echo ""
		echo "==> Updating flake inputs..."
		nix flake update "$REPO"
	fi

	# Phase 3: Confirm and deploy
	echo ""
	read -r -p "Deploy these changes? [y/N] " reply
	if [[ "$reply" != "y" && "$reply" != "Y" ]]; then
		echo "Aborted."
		return 0
	fi

	cmd_deploy

	# Phase 4 (optional): Kernel check
	if [[ "$check_kernel" -eq 1 ]]; then
		echo ""
		echo "==> Checking BORE patch drift..."
		bash "$REPO/kernel/check-upstream.sh" --quiet || true
	fi

	echo ""
	echo "==> Update complete."
}

# Window controls for the native WSLg sway window via windowctl — a tiny
# cross-compiled Win32 helper. The old PowerShell + Add-Type approach
# spawned powershell.exe per click, whose startup alone cost ~2s: buttons
# felt dead. windowctl finds any top-level window whose title matches
# "wlroots" (WSLg names them "wlroots - WL-N (hostname)") and applies a
# ShowWindow action in milliseconds.
#
# The exe lives in the nix store, which Windows cannot exec; it is copied
# to a drvfs path (C:\Users\<user>\.cellar\) on first use.
windowctl() {
	local dest
	dest="/mnt/c/Users/$(whoami)/.cellar/windowctl.exe"
	mkdir -p "$(dirname "$dest")" 2>/dev/null || true
	# The copied exe inherits the nix store's 0555 mode, so a plain cp
	# cannot overwrite it and the copy silently goes stale (which made
	# `cellar extend` report "unknown action list-monitors"). Unlink
	# first — the directory is writable — then copy fresh.
	if ! cmp -s "${WINDOWCTL:?windowctl not baked into cellar}" "$dest" 2>/dev/null; then
		rm -f "$dest" 2>/dev/null || true
		cp "${WINDOWCTL}" "$dest" 2>/dev/null || true
	fi
	[[ -x "$dest" ]] || return 1
	"$dest" "$@" 2>/dev/null || true
}

# Minimize: SW_MINIMIZE (6)
cmd_minimize() {
	windowctl minimize
}

# Maximize toggle: checks WS_MAXIMIZE via GWL_STYLE; maximized → SW_RESTORE,
# windowed → SW_MAXIMIZE.
cmd_maximize() {
	windowctl maximize
}

# Move the desktop window onto another monitor and fill it. The window has
# no title bar (WSLg RAIL) and is usually maximized, so it cannot be
# dragged — this is how it moves between screens. Bare: pick from a
# fuzzel list. next/prev: cycle without a picker (for sway keybinds).
cmd_extend() {
	local pick="${1:-}"
	if [[ -z "$pick" ]]; then
		local monitors sel
		monitors="$(windowctl list-monitors)"
		[[ -z "$monitors" ]] && return 0
		sel="$(printf '%s\n' "$monitors" |
			sed -E 's/^([0-9]+) ([0-9]+x[0-9]+) @([^ ]+)( primary)?$/Monitor \1  \2  \3\4/' |
			fuzzel --dmenu --prompt 'Extend to' --width 34 --lines 8)" || return 0
		[[ -z "$sel" ]] && return 0
		pick="${sel#Monitor }"
		pick="${pick%% *}"
	fi
	windowctl move-to-monitor "$pick"
}

# Shrink the desktop window back to a windowed size (un-maximize).
cmd_shrink() {
	windowctl restore
}

# Fully close the desktop: stop the sway service so the window goes away
# and the output watchdog has nothing to resurrect. Relaunch with:
#   cellar ui
cmd_close() {
	systemctl --user stop sway-headless 2>/dev/null || true
}

# Relaunch the sway desktop UI after a close.
cmd_ui() {
	systemctl --user start sway-headless 2>/dev/null || true
}

# Detach a GUI app so it outlives the launcher/menu process that started it.
launch_gui() {
	nohup "$@" >/dev/null 2>&1 &
}

# Start menu: a fuzzel menu branching into the common destinations. Rows
# use fuzzel's rofi-style icon protocol (Label\0icon\x1f<name>) so the
# menu has Papirus icons; fuzzel strips the escape, so $choice is a bare
# label. Every entry also has a keybind (see cellar-help) — the mouse is
# a shortcut, never the only way. See docs/CONVENIENT-DESKTOP.md.
cmd_menu() {
	local choice
	choice="$(
		printf '%s\0icon\x1f%s\n' \
			'Applications'   'applications-other' \
			'Terminal'       'utilities-terminal' \
			'Files'          'system-file-manager' \
			'Software'       'software-store' \
			'Settings'       'preferences-system' \
			'System monitor' 'gnome-system-monitor' \
			'Close desktop'  'system-shutdown' |
			fuzzel --dmenu --prompt 'cellar' --width 28 --lines 7
	)" || return 0
	case "$choice" in
	Applications) launch_gui nwg-drawer ;;
	Terminal) launch_gui foot ;;
	Files) launch_gui nautilus ;;
	Software) cmd_store ;;
	Settings) launch_gui gnome-control-center ;;
	"System monitor") launch_gui gnome-system-monitor ;;
	"Close desktop") cmd_close ;;
	esac
}

# Software center: search nixpkgs, click a result, install declaratively.
# The pick goes through `cellar add`, so it lands in
# modules/user-packages.list and deploys — nothing lands in a nix profile.
cmd_store() {
	local query
	query="$(fuzzel --dmenu --prompt-only 'Search nixpkgs' --width 44)" || return 0
	[[ -z "$query" ]] && return 0
	local line
	line="$(
		nix search nixpkgs "$query" --json 2>/dev/null |
			jq -r 'to_entries[] | "\(.key | sub("legacyPackages\\.[^.]*\\."; "") | sub("packages\\.[^.]*\\."; ""))  \(.value.description // "")"' |
			fuzzel --dmenu --prompt 'install' --width 70 --lines 18
	)" || return 0
	[[ -z "$line" ]] && return 0
	# fuzzel shows "name  description"; package names contain no spaces.
	cmd_add "${line%% *}"
}

# The visual software center (pkgs/cellar-software-center). Falls back to
# the fuzzel picker when the app is not installed (e.g. lean machines).
cmd_center() {
	if command -v cellar-software-center >/dev/null 2>&1; then
		launch_gui cellar-software-center
	else
		echo "Software center not installed; using the quick picker." >&2
		cmd_store
	fi
}

# Clipboard history picker (cliphist + wl-clipboard).
cmd_clipboard() {
	local sel
	sel="$(cliphist list | fuzzel --dmenu --prompt 'clipboard' --width 55 --lines 14 --no-run-if-empty)" || return 0
	[[ -z "$sel" ]] && return 0
	printf '%s' "$sel" | cliphist decode | wl-copy
}

# Move the focused window to another workspace. Workspaces are created on
# demand in sway, so the picker lists existing ones and accepts a typed
# number for a new one (fuzzel is a text input too). Keyboard path:
# Ctrl+Alt+M.
cmd_move_to_workspace() {
	local pick focused
	pick="$(
		swaymsg -t get_workspaces |
			jq -r '.[].name' |
			fuzzel --dmenu --prompt 'Move to workspace' --width 24 --lines 8
	)" || return 0
	[[ -z "$pick" ]] && return 0
	focused="$(swaymsg -t get_tree | jq -r '.. | objects | select(.focused == true) | .id' | head -1)"
	[[ -z "$focused" ]] && return 0
	swaymsg "[con_id=$focused] move container to workspace \"$pick\""
}

# Region screenshot to the clipboard (grim + slurp).
cmd_screenshot() {
	local geom
	geom="$(slurp)" || return 0
	[[ -z "$geom" ]] && return 0
	grim -g "$geom" - | wl-copy
}

cmd_overlay() {
	local cmd="/mnt/c/Windows/System32/cmd.exe"
	# Maximize the native WSLg sway window. Toggles between maximized
	# and windowed (same as `cellar maximize`).
	cmd_maximize
	# Optional: kill WezTerm so the shared Zellij session's only client
	# is the sway-internal foot. Pass --kill-wezterm to force.
	if [[ "${1:-}" == "--kill-wezterm" ]]; then
		"$cmd" /c "taskkill /IM wezterm-gui.exe /F" >/dev/null 2>&1 || true
	fi
}

cmd_netcheck() {
	echo "=== RootCellar Network Check ==="
	echo ""
	echo "--- Mirrored mode ---"
	if [[ -f "/mnt/c/Users/${SUDO_USER:-$(whoami)}/.wslconfig" ]]; then
		grep -E "^(networkingMode|dnsTunneling|localhostForwarding|hostAddressLoopback)" \
			"/mnt/c/Users/${SUDO_USER:-$(whoami)}/.wslconfig" 2>/dev/null || echo "(none found)"
	else
		echo "No .wslconfig found"
	fi
	echo ""
	echo "--- Default gateway ---"
	ip route show default 2>/dev/null || echo "(no default route)"
	echo ""
	echo "--- resolv.conf ---"
	cat /etc/resolv.conf 2>/dev/null || echo "(missing)"
	echo ""
	echo "--- DNS resolution test ---"
	if curl -sf --max-time 5 https://1.1.1.1 >/dev/null 2>&1; then
		echo "DNS: OK (Cloudflare reachable)"
	else
		echo "DNS: FAILED (Cloudflare unreachable)"
	fi
	echo ""
	echo "--- Localhost loopback test ---"
	local test_pid=""
	python3 -c "
import socket, sys
s = socket.socket()
s.settimeout(2)
try:
    s.bind(('127.0.0.1', 19999))
    s.listen(1)
    print('ok')
except Exception as e:
    print(f'bind failed: {e}', file=sys.stderr)
    sys.exit(1)
" 2>/dev/null &
	test_pid=$!
	sleep 0.5
	if curl -sf --max-time 2 http://127.0.0.1:19999 >/dev/null 2>&1; then
		echo "Localhost loopback: OK"
	else
		echo "Localhost loopback: FAILED (127.0.0.1 may route via loopback0)"
		echo "  Try: sudo ip rule add pref 0 iif lo to 127.0.0.0/8 lookup local"
	fi
	kill "$test_pid" 2>/dev/null || true
	wait "$test_pid" 2>/dev/null || true
}

cmd_docker_doctor() {
	echo "=== Docker Desktop Doctor ==="
	echo ""
	if [[ -d "/mnt/c/Program Files/Docker/Docker" ]]; then
		echo "Docker Desktop: installed"
	else
		echo "Docker Desktop: NOT found"
	fi
	echo ""
	echo "If Docker Desktop WSL2 Integration is enabled, it overrides"
	echo "the native Docker Engine in the cellar. Disable it in:"
	echo "  Docker Desktop -> Settings -> Resources -> WSL Integration"
	echo ""
	echo "--- Kernel ISO9660 support ---"
	if zgrep CONFIG_ISO9660_FS /proc/config.gz 2>/dev/null | grep -q "=y"; then
		echo "ISO9660 (Docker Desktop): built-in (OK)"
	else
		echo "ISO9660 (Docker Desktop): MISSING"
		echo "  You are running a kernel built before the 2026-09-11 fix."
		echo "  Rebuild: nix develop .#kernel -c ./build-kernel.sh"
		echo "  Then: wsl --shutdown and relaunch the distro."
		echo "  build-kernel.sh now refuses to install a kernel without it."
	fi
	echo ""
	echo "--- Native Docker Engine ---"
	if systemctl is-active --quiet docker 2>/dev/null; then
		echo "Native Docker: running"
	elif command -v docker >/dev/null 2>&1; then
		echo "Native Docker: installed but not running"
	else
		echo "Native Docker: not installed (enable with cellar.docker.enable in flake)"
	fi
	echo ""
	echo "--- Kernel bridge support (native Docker networking) ---"
	if zgrep -q "^CONFIG_BRIDGE=y" /proc/config.gz 2>/dev/null; then
		echo "Bridge: built-in (OK)"
	else
		echo "Bridge: NOT built-in — dockerd cannot create docker0"
		echo "  ('Failed to create bridge docker0 via netlink: operation not supported')."
		echo "  The bore.fragment pins the bridge/iptables stack; rebuild the kernel:"
		echo "    nix develop .#kernel -c ./build-kernel.sh"
		echo "  Then: wsl --shutdown and relaunch the distro."
	fi
}

# WSL interop check: windowctl (the waybar window controls), powershell
# and cmd all run as Windows .exe via the WSLInterop binfmt handler. If it
# is missing, .exe calls fail with "Exec format error" and the window
# buttons silently die. The config registers it declaratively
# (wsl.interop.register); this surfaces the gap before it bites.
cmd_interop() {
	echo "=== WSL Interop ==="
	echo ""
	if [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]]; then
		echo "WSLInterop: registered (OK)"
	else
		echo "WSLInterop: MISSING — Windows .exe cannot run from the cellar."
		echo "  windowctl (minimize/maximize/extend), powershell and cmd all break."
		echo "  Immediate fix (needs root):"
		echo "    echo ':WSLInterop:M::MZ::/init:PF' | sudo tee /proc/sys/fs/binfmt_misc/register"
		echo "  Permanent fix: deploy once — wsl.interop.register = true re-adds"
		echo "  it at every boot (systemd-binfmt)."
	fi
	echo ""
	echo "--- binfmt_misc entries ---"
	ls /proc/sys/fs/binfmt_misc/ 2>/dev/null
}

git_require_identity() {
	if [[ -z "$(git -C "$REPO" config user.email 2>/dev/null)" ]]; then
		echo "git identity missing in $REPO (user.email)." >&2
		echo "  git -C $REPO config user.email 'you@example.com'" >&2
		exit 66
	fi
}

# Stage the named files, commit, push. Push failure degrades to a local
# commit with a notice — the Windows-side checkout still has the changes.
git_commit_push() {
	local msg="$1"
	shift
	git_require_identity
	git -C "$REPO" add "$@"
	if git -C "$REPO" commit -m "$msg" >/dev/null; then
		if git -C "$REPO" push >/dev/null 2>&1; then
			echo "Saved + pushed: $msg"
		else
			echo "Committed locally, but push failed — push from the Windows side." >&2
		fi
	else
		echo "Nothing to commit."
	fi
}

toml_get_str() {
	# Top-level string key in cellar.toml.
	sed -n "s/^$1 = \"\(.*\)\"/\1/p" "$CELLAR_TOML" 2>/dev/null | tail -1
}

toml_set_str() {
	# Rewrite a top-level string key; appends it if the key is absent.
	if grep -q "^$1 = " "$CELLAR_TOML" 2>/dev/null; then
		sed -i "s|^$1 = .*|$1 = \"$2\"|" "$CELLAR_TOML"
	else
		printf '%s = "%s"\n' "$1" "$2" >>"$CELLAR_TOML"
	fi
}

toml_toggle_bool() {
	# Flip `enable` inside one [section] (range ends at the next section
	# header, or EOF for the last one).
	local from="on"
	if sed -n "/^\\[$1\\]/,/^\[/p" "$CELLAR_TOML" 2>/dev/null | grep -q "enable = true"; then
		from="true"
	fi
	if [[ "$from" == "true" ]]; then
		sed -i "/^\\[$1\\]/,/^\[/ s/^enable = true/enable = false/" "$CELLAR_TOML"
	else
		sed -i "/^\\[$1\\]/,/^\[/ s/^enable = false/enable = true/" "$CELLAR_TOML"
	fi
}

toml_get_bool() {
	sed -n "/^\\[$1\\]/,/^\[/p" "$CELLAR_TOML" 2>/dev/null | grep -q "enable = true" && echo on || echo off
}

pkg_validate() {
	# Attribute paths only: letters/digits/underscore, dot-separated.
	[[ "$1" =~ ^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)*$ ]] || return 1
	nix eval --raw "nixpkgs#$1.name" >/dev/null 2>&1
}

cmd_search() {
	[[ $# -gt 0 ]] || {
		echo "Usage: cellar search <query>" >&2
		exit 64
	}
	# --json: normalized {attr, description} list for the software center.
	if [[ "${1:-}" == "--json" ]]; then
		shift
		[[ $# -gt 0 ]] || {
			echo "Usage: cellar search --json <query>" >&2
			exit 64
		}
		nix search nixpkgs "$@" --json 2>/dev/null | jq -c '
			to_entries | map({
				attr: (.key | sub("^legacyPackages\\.[^.]*\\."; "")),
				pname: (.value.pname // ""),
				description: (.value.description // "")
			})' 2>/dev/null || echo '[]'
		return
	fi
	exec nix search nixpkgs "$@"
}

cmd_check() {
	[[ $# -gt 0 ]] || {
		echo "Usage: cellar check <pkg>..." >&2
		exit 64
	}
	local p rc=0
	for p in "$@"; do
		if pkg_validate "$p"; then
			printf 'ok   %s\n' "$p"
		else
			printf 'MISS %s (try: cellar search)\n' "$p"
			rc=1
		fi
	done
	return "$rc"
}

cmd_add() {
	[[ $# -gt 0 ]] || {
		echo "Usage: cellar add <pkg>..." >&2
		exit 64
	}
	[[ -f "$PACKAGES_LIST" ]] || {
		echo "Not found: $PACKAGES_LIST" >&2
		exit 66
	}
	local p bad=() to_add=()
	for p in "$@"; do
		if ! pkg_validate "$p"; then
			bad+=("$p")
		elif ! grep -qx "$p" "$PACKAGES_LIST"; then
			to_add+=("$p")
		fi
	done
	((${#bad[@]})) && {
		printf 'Not found in nixpkgs: %s\n' "${bad[*]}" >&2
		echo "Try: cellar search <query>" >&2
		exit 66
	}
	((${#to_add[@]})) || {
		echo "Already installed: $*"
		return 0
	}
	for p in "${to_add[@]}"; do
		printf '%s\n' "$p" >>"$PACKAGES_LIST"
	done
	git_commit_push "cellar add: ${to_add[*]}" "$REPO/modules/user-packages.list"
	if [[ -z "${CELLAR_NO_PROMPT:-}" ]]; then
		read -r -p "Deploy now? [y/N] " reply
		[[ "$reply" == "y" || "$reply" == "Y" ]] && cmd_deploy
	fi
}

cmd_remove() {
	[[ $# -gt 0 ]] || {
		echo "Usage: cellar remove <pkg>..." >&2
		exit 64
	}
	[[ -f "$PACKAGES_LIST" ]] || {
		echo "Not found: $PACKAGES_LIST" >&2
		exit 66
	}
	local p removed=()
	for p in "$@"; do
		if grep -qx "$p" "$PACKAGES_LIST"; then
			grep -vx -F "$p" "$PACKAGES_LIST" >"$PACKAGES_LIST.tmp" && mv "$PACKAGES_LIST.tmp" "$PACKAGES_LIST"
			removed+=("$p")
		fi
	done
	((${#removed[@]})) || {
		echo "Not in user-packages.list (the static chest lives in modules/packages.nix)."
		return 0
	}
	git_commit_push "cellar remove: ${removed[*]}" "$REPO/modules/user-packages.list"
	if [[ -z "${CELLAR_NO_PROMPT:-}" ]]; then
		read -r -p "Deploy now? [y/N] " reply
		[[ "$reply" == "y" || "$reply" == "Y" ]] && cmd_deploy
	fi
}

# ── Package lanes ───────────────────────────────────────────────────
# Two lanes, one vocabulary:
#   local  — nix profile (this user, instant, not in git)
#   frozen — modules/user-packages.list (declarative, git-backed)
# The software center (`cellar center`) is a front-end to these.

# Local lane: install into this user's profile without a rebuild. Uses the
# pinned nixpkgs registry entry, so it hits the binary cache.
cmd_use() {
	[[ $# -gt 0 ]] || {
		echo "Usage: cellar use <pkg>..." >&2
		exit 64
	}
	local p failed=()
	for p in "$@"; do
		if nix profile install "nixpkgs#$p"; then
			echo "local: $p"
		else
			failed+=("$p")
		fi
	done
	if ((${#failed[@]})); then
		printf 'Failed: %s\n' "${failed[*]}" >&2
		return 1
	fi
	return 0
}

# Local lane: remove from this user's profile.
cmd_unuse() {
	[[ $# -gt 0 ]] || {
		echo "Usage: cellar unuse <pkg>..." >&2
		exit 64
	}
	local p
	for p in "$@"; do
		nix profile remove "$p" || echo "Not in profile: $p" >&2
	done
}

# Frozen lane: promote to the declarative list (git commit; no deploy).
# `cellar add` with the interactive deploy prompt suppressed.
cmd_freeze() {
	CELLAR_NO_PROMPT=1 cmd_add "$@"
}

# Frozen lane: drop from the declarative list (git commit; no deploy).
cmd_unfreeze() {
	CELLAR_NO_PROMPT=1 cmd_remove "$@"
}

# Machine-readable state for the software center.
#   cellar profile --json -> installed local packages
#   cellar frozen  --json -> packages in user-packages.list
cmd_profile() {
	if [[ "${1:-}" == "--json" ]]; then
		nix profile list --json 2>/dev/null | jq -c '
			[ .elements | to_entries[] | {
				name: (.value.attrPath // .key | split(".") | last),
				url: (.value.originalUrl // ""),
				storePath: ((.value.storePaths // []) | first // "")
			} ]' 2>/dev/null || echo '[]'
		return
	fi
	echo "Local packages (nix profile):"
	nix profile list 2>/dev/null || echo "  (none)"
}

cmd_frozen() {
	if [[ "${1:-}" == "--json" ]]; then
		jq -R -s 'split("\n") | map(select(length > 0 and (startswith("#") | not)))' \
			"$PACKAGES_LIST" 2>/dev/null || echo '[]'
		return
	fi
	echo "Frozen packages (modules/user-packages.list):"
	grep -vE '^[[:space:]]*(#|$)' "$PACKAGES_LIST" 2>/dev/null || echo "  (none)"
}

cmd_link() {
	local url="${1:-}"
	if [[ -z "$url" ]]; then
		echo "Origin: $(git -C "$REPO" remote get-url origin 2>/dev/null || echo '(not linked)')"
		git -C "$REPO" status -sb 2>/dev/null | head -5
		return 0
	fi
	if [[ ! -d "$REPO/.git" ]]; then
		if [[ -e "$REPO" ]]; then
			echo "$REPO exists and is not a git repo — refusing to clobber." >&2
			exit 66
		fi
		echo "Cloning $url -> $REPO"
		git clone "$url" "$REPO"
	else
		local current
		current="$(git -C "$REPO" remote get-url origin 2>/dev/null || echo none)"
		[[ "$current" == "$url" ]] && {
			echo "Already linked to $url"
			return 0
		}
		read -r -p "Re-point origin from '$current' to '$url'? [y/N] " reply
		[[ "$reply" == "y" || "$reply" == "Y" ]] || {
			echo "Aborted."
			return 0
		}
		git -C "$REPO" remote set-url origin "$url"
		echo "Origin re-pointed."
	fi
	read -r -p "Deploy now? [y/N] " reply
	[[ "$reply" == "y" || "$reply" == "Y" ]] && cmd_deploy
}

cmd_save() {
	[[ -d "$REPO/.git" ]] || {
		echo "Not a git repo: $REPO" >&2
		exit 66
	}
	if [[ -z "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]]; then
		echo "Nothing to save."
		return 0
	fi
	git -C "$REPO" status --short | head -8
	git_commit_push "cellar save: $(date +%F\ %H:%M)" "$REPO"
}

cmd_pkgs() {
	while true; do
		local sel
		sel="$(
			printf 'Install from nixpkgs\nRemove installed\nInstalled list\nBack\n' |
				fzf --height=40% --reverse --prompt='cellar pkgs> '
		)" || return 0
		case "$sel" in
		"Install from nixpkgs")
			local q
			read -r -p "Search nixpkgs for: " q
			[[ -z "$q" ]] && continue
			local picks
			picks="$(
				nix search nixpkgs "$q" --json 2>/dev/null |
					jq -r 'to_entries[] | "\(.key | sub("legacyPackages\\.[^.]*\\."; "") | sub("packages\\.[^.]*\\."; ""))|\(.value.description // "")"' |
					fzf --multi --height=60% --reverse --with-nth 2 --delimiter='|' --prompt='install> '
			)" || continue
			[[ -z "$picks" ]] && continue
			# shellcheck disable=SC2086
			cmd_add "$(cut -d'|' -f1 <<<"$picks" | tr '\n' ' ')"
			;;
		"Remove installed")
			local picks
			picks="$(
				grep -v '^#' "$PACKAGES_LIST" 2>/dev/null | grep -v '^$' |
					fzf --multi --height=60% --reverse --prompt='remove> '
			)" || continue
			[[ -z "$picks" ]] && continue
			cmd_remove "$picks"
			;;
		"Installed list")
			cmd_check "$(grep -v '^#' "$PACKAGES_LIST" 2>/dev/null | grep -v '^$')" | sed 's/^/  /'
			echo "  (+ the static chest in modules/packages.nix)"
			;;
		*) return 0 ;;
		esac
	done
}

cmd_config() {
	# Settings + features only. Packages have their own screen
	# (cellar pkgs); repository ops are cellar link / cellar save.
	[[ -f "$CELLAR_TOML" ]] || touch "$CELLAR_TOML"
	while true; do
		local sel
		sel="$(
			printf 'Settings\nFeatures\nApply (deploy)\nQuit\n' |
				fzf --height=40% --reverse --header='cellar config — the cozy layer (docs/CELLAR-CONFIG.md)' --prompt='cellar> '
		)" || return 0
		case "$sel" in
		"Settings")
			while true; do
				local s sel2 new
				for s in timezone locale hostname; do
					printf '%s = %s\n' "$s" "$(toml_get_str "$s")"
				done >/tmp/opencode/cfg-settings.$$
				sel2="$(fzf --height=40% --reverse --prompt='settings> ' </tmp/opencode/cfg-settings.$$)" || {
					rm -f /tmp/opencode/cfg-settings.$$
					break
				}
				rm -f /tmp/opencode/cfg-settings.$$
				s="${sel2%% = *}"
				read -r -p "new $s: " new
				[[ -n "$new" ]] && toml_set_str "$s" "$new"
			done
			;;
		"Features")
			while true; do
				local f sel3
				for f in docker cuda webtop; do
					printf '%s [%s]\n' "$f" "$(toml_get_bool "$f")"
				done >/tmp/opencode/cfg-feat.$$
				sel3="$(fzf --height=40% --reverse --prompt='features> ' </tmp/opencode/cfg-feat.$$)" || {
					rm -f /tmp/opencode/cfg-feat.$$
					break
				}
				rm -f /tmp/opencode/cfg-feat.$$
				f="${sel3%% *}"
				toml_toggle_bool "$f"
				echo "$f -> $(toml_get_bool "$f")"
			done
			;;
		"Apply (deploy)")
			read -r -p "Deploy the current config? [y/N] " reply
			[[ "$reply" == "y" || "$reply" == "Y" ]] && cmd_deploy
			;;
		*) return 0 ;;
		esac
	done
}

case "${1:-deskbottom}" in
	deskbottom | desktop) cmd_desktop ;;
	app | start) shift || true; cmd_app "${1:-}" ;;
	list | apps) cmd_list ;;
	kill | shutdown) cmd_kill ;;
	deploy) shift || true; cmd_deploy "${1:-}" ;;
	deploy-root) cmd_deploy_root ;;
	deploy-user) cmd_deploy_user ;;
	deploy-sync) cmd_deploy_sync ;;
	update) shift || true; cmd_update "$@" ;;
	overlay) shift || true; cmd_overlay "$@" ;;
	maximize) cmd_maximize ;;
	minimize) cmd_minimize ;;
	extend) shift || true; cmd_extend "${1:-}" ;;
	shrink) cmd_shrink ;;
	close) cmd_close ;;
	ui) cmd_ui ;;
	menu) cmd_menu ;;
	store | software) cmd_store ;;
	center) cmd_center ;;
	clipboard) cmd_clipboard ;;
	move-to-workspace | move) cmd_move_to_workspace ;;
	screenshot) cmd_screenshot ;;
	fullscreen) cmd_maximize ;; # alias for backward compat
	refresh) cmd_refresh ;;
	netcheck) cmd_netcheck ;;
	docker-doctor) cmd_docker_doctor ;;
	interop) cmd_interop ;;
	config | settings) cmd_config ;;
	pkgs | packages) cmd_pkgs ;;
	search) shift || true; cmd_search "$@" ;;
	check) shift || true; cmd_check "$@" ;;
	add | install) shift || true; cmd_add "$@" ;;
	remove | uninstall) shift || true; cmd_remove "$@" ;;
	use) shift || true; cmd_use "$@" ;;
	unuse) shift || true; cmd_unuse "$@" ;;
	freeze) shift || true; cmd_freeze "$@" ;;
	unfreeze) shift || true; cmd_unfreeze "$@" ;;
	profile) shift || true; cmd_profile "$@" ;;
	frozen) shift || true; cmd_frozen "$@" ;;
	link) shift || true; cmd_link "${1:-}" ;;
	save) cmd_save ;;
	-h | --help | help) usage ;;
	*)
		echo "Unknown command: $1" >&2
		usage >&2
		exit 64
		;;
esac
