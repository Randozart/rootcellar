#!/usr/bin/env bash
# cellar — start menu and session control for the RootCellar deskbottom.
#
# Usage:
#   cellar [deskbottom]  attach to (or boot) the deskbottom
#   cellar app [key]     start menu: fuzzy-pick an app from apps.toml
#   cellar list          list registered apps and whether they are installed
#   cellar kill          tear down the cellar session (asks first)
#   cellar deploy        sync repo -> /opt and rebuild (--no-rebuild to skip)
#   cellar refresh       clear sessions and boot the desk fresh

set -Eeuo pipefail

SESSION="${CELLAR_SESSION:-cellar}"
APPS_FILE="${CELLAR_APPS:-/etc/cellar/apps.toml}"
REPO="/mnt/c/Users/randy/Documents/Projects/rootcellar"
TARGET="/opt/rootcellar"

usage() {
	sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}
toml_value() {
	# Right side of the first '=', whitespace-trimmed, then quote-trimmed.
	local v="${1#*=}"
	v="${v#"${v%%[![:space:]]*}"}"
	v="${v%"${v##*[![:space:]]}"}"
	v="${v#\"}"
	v="${v%\"}"
	printf '%s' "$v"
}

parse_apps() {
	# Emits TSV: key <TAB> name <TAB> command
	local key="" name="" cmd=""
	local line
	while IFS= read -r line || [[ -n "$line" ]]; do
		case "$line" in
			"["*"]")
				if [[ -n "$key" && -n "$cmd" ]]; then
					printf '%s\t%s\t%s\n' "$key" "$name" "$cmd"
				fi
				key="${line#\[}"
				key="${key%\]}"
				name=""
				cmd=""
				;;
			name\ =\ * | name=*)
				name="$(toml_value "$line")"
				;;
			command\ =\ * | command=*)
				cmd="$(toml_value "$line")"
				;;
		esac
	done <"$APPS_FILE"
	if [[ -n "$key" && -n "$cmd" ]]; then
		printf '%s\t%s\t%s\n' "$key" "$name" "$cmd"
	fi
}

in_zellij() { [[ -n "${ZELLIJ:-}" ]]; }

launch() {
	local cmd="$1"
	if in_zellij; then
		zellij action new-pane --close-on-exit -- bash -lc "$cmd"
	else
		exec bash -lc "$cmd"
	fi
}

cmd_desktop() {
	if command -v zellij >/dev/null 2>&1; then
		exec zellij attach "$SESSION" --create
	else
		echo "zellij is not installed; the deskbottom cannot boot." >&2
		exit 69
	fi
}

cmd_app() {
	local key="${1:-}"
	if [[ -z "$key" ]]; then
		local selection
		selection="$(
			parse_apps | awk -F'\t' '{ printf "%s  %-28s [%s]\n", $1, $2, $3 }' |
				fzf --height=40% --reverse --prompt="cellar> "
		)" || return 0
		key="${selection%%[[:space:]]*}"
	fi

	local row
	row="$(parse_apps | awk -F'\t' -v k="$key" '$1 == k { print; exit }')"
	if [[ -z "$row" ]]; then
		echo "No app registered under key '$key'. Try: cellar list" >&2
		exit 66
	fi

	local cmd
	cmd="$(printf '%s' "$row" | awk -F'\t' '{ print $3 }')"
	launch "$cmd"
}

cmd_list() {
	while IFS=$'\t' read -r key name cmd; do
		if command -v "${cmd%% *}" >/dev/null 2>&1; then
			printf 'ok   %s  %s\n' "$key" "$name"
		else
			printf 'MISS %s  %s  (%s not found)\n' "$key" "$name" "${cmd%% *}"
		fi
	done < <(parse_apps)
}

cmd_kill() {
	read -r -p "Kill Zellij session '$SESSION'? All running panes will die. [y/N] " reply
	if [[ "$reply" == "y" || "$reply" == "Y" ]]; then
		zellij kill-session "$SESSION"
	else
		echo "Aborted."
	fi
}

cmd_deploy() {
	local rebuild=1
	if [[ "${1:-}" == "--no-rebuild" ]]; then
		rebuild=0
	elif [[ -n "${1:-}" ]]; then
		echo "Unknown flag: $1 (supported: --no-rebuild)" >&2
		exit 64
	fi
	if [[ ! -d "$REPO" ]]; then
		echo "Repo not found: $REPO" >&2
		exit 66
	fi

	# The repo is the source of truth; /opt is a derived mirror. The mirror's
	# flake must keep local path inputs (the cellar cannot fetch from github),
	# so the sync re-derives them after every copy.
	sudo bash -c '
		set -Eeuo pipefail
		tar -C "$1" --exclude=.git -cf - . | tar -xf - -C "$2"
		sed -i \
			-e "s|github:NixOS/nixpkgs/nixos-25.05|path:/opt/nixpkgs-ac62194c3917d5f474c1a844b6fd6da2db95077d|" \
			-e "s|github:NixOS/nixpkgs/nixos-unstable|path:/opt/nixpkgs-nixos-unstable|" \
			-e "s|github:nix-community/NixOS-WSL|path:/opt/NixOS-WSL-eaeb18da90024448a60eb1ec7132eafa4003404e|" \
			"$2/flake.nix"
	' deploy "$REPO" "$TARGET"

	if [[ "$rebuild" -eq 1 ]]; then
		sudo /run/current-system/sw/bin/nixos-rebuild switch --flake "$TARGET#rootcellar"
		echo "cellar deploy: synced and switched"
	else
		echo "cellar deploy: synced (no rebuild)"
	fi
}

cmd_refresh() {
	local running
	running="$(zellij list-sessions -s 2>/dev/null | grep -vc EXITED || true)"
	if [[ "$running" -gt 0 ]]; then
		read -r -p "Kill $running running session(s) and boot the desk fresh? [y/N] " reply
		if [[ "$reply" != "y" && "$reply" != "Y" ]]; then
			echo "Aborted."
			return 0
		fi
	fi
	if in_zellij; then
		# Killing the session we are inside of would cut this command off
		# mid-flight, so spare $ZELLIJ and hand control back: an explicit
		# Ctrl+q quits without leaving resurrection state, and the next
		# login boots fresh.
		while IFS= read -r s; do
			[[ -n "$s" && "$s" != "$ZELLIJ" ]] && zellij kill-session "$s" 2>/dev/null || true
		done < <(zellij list-sessions -s 2>/dev/null | grep -v EXITED)
		zellij delete-all-sessions --yes 2>/dev/null || true
		echo "Refreshed (other sessions cleared). Exit Zellij with Ctrl+q;"
		echo "the deskbottom comes back fresh on autostart."
	else
		zellij kill-all-sessions --yes 2>/dev/null || true
		zellij delete-all-sessions --yes 2>/dev/null || true
		exec zellij attach "$SESSION" --create
	fi
}

case "${1:-deskbottom}" in
	deskbottom | desktop) cmd_desktop ;;
	app | start) shift || true; cmd_app "${1:-}" ;;
	list | apps) cmd_list ;;
	kill | shutdown) cmd_kill ;;
	deploy) shift || true; cmd_deploy "${1:-}" ;;
	refresh) cmd_refresh ;;
	-h | --help | help) usage ;;
	*)
		echo "Unknown command: $1" >&2
		usage >&2
		exit 64
		;;
esac
