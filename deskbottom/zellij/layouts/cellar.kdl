// The RootCellar desktop layout: what you see when you boot into the cellar.
// Tab bar on top, status bar on the bottom, four default rooms.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="shell" focus=true {
        pane
    }

    tab name="monitor" {
        pane command="btop" close_on_exit=true
    }

    tab name="files" {
        pane command="yazi" close_on_exit=true
    }

    tab name="config" {
        pane {
            plugin location="zellij:configuration"
        }
    }
}
