# RootCellar BORE kernel config fragment.
# Merged on top of Microsoft/config-wsl by build-kernel.sh via
# scripts/kconfig/merge_config.sh, then settled with olddefconfig.
#
# SCHED_BORE and MIN_BASE_SLICE_NS exist only after the BORE patch is applied.
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=2000000

# 1000 Hz tick: lower scheduling latency, matches CachyOS desktop defaults.
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# uname -r identifies the room you are in.
CONFIG_LOCALVERSION="-rootcellar-bore"
# No "+" suffix from the dirty patched tree.
CONFIG_LOCALVERSION_AUTO=n

# btrfs is built-in (=y), not a module: the projects VHD is bare-attached by
# Windows and there are no loadable kernel modules on the WSL side, so a
# module would never be found. Built-in survives both stock and BORE boots.
CONFIG_BTRFS_FS=y

# Docker Desktop's LinuxKit bootstrap mounts ISO9660 images.
# Built-in (=y), not module: WSL2 never populates /lib/modules/.
CONFIG_ISO9660_FS=y
