# RootCellar BORE kernel config fragment.
# Merged on top of Microsoft/config-wsl by build-kernel.sh via
# scripts/kconfig/merge_config.sh, then settled with olddefconfig.
#
# SCHED_BORE and MIN_BASE_SLICE_NS exist only after the BORE patch is applied.
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=2000000

# 1000 Hz tick: lower scheduling latency, matches CachyOS desktop defaults.
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# uname -r identifies the room you are in.
CONFIG_LOCALVERSION="-rootcellar-bore"
# No "+" suffix from the dirty patched tree.
CONFIG_LOCALVERSION_AUTO=n

# btrfs is built-in (=y), not a module: the projects VHD is bare-attached by
# Windows and there are no loadable kernel modules on the WSL side, so a
# module would never be found. Built-in survives both stock and BORE boots.
CONFIG_BTRFS_FS=y

# Docker Desktop's LinuxKit bootstrap mounts ISO9660 images.
# Built-in (=y), not module: WSL2 never populates /lib/modules/.
CONFIG_ISO9660_FS=y

# Docker (native engine) needs the bridge/iptables stack built-in.
# config-wsl ships all of this as =m; stock WSL2 works only because
# distros ship matching .ko files for the stock kernel, and the custom
# kernel has no module tree. Without these pins dockerd dies with:
#   Failed to create bridge docker0 via netlink: operation not supported
# Bridge device + br_netfilter (bridge-nf-call-iptables).
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
# The iptables family dockerd programs by default.
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_NETFILTER_XT_NAT=y
# xtables matches/targets dockerd probes explicitly (addrtype is a hard
# requirement; MASQUERADE is what makes -p 80:80 work).
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NF_CT_NETLINK=y
# nftables expressions dockerd may use instead of iptables.
CONFIG_NFT_FIB=y
CONFIG_NFT_REDIR=y
# Misc netdevs: macvlan networks, host/VPN tooling, dummy test links.
CONFIG_MACVLAN=y
CONFIG_TUN=y
CONFIG_DUMMY=y
